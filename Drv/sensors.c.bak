#define EXT_CS				GPIO_PA1

#define GSR_IMITATION		1

#ifndef GSR_WARNING_TIMEOUT
#define GSR_WARNING_TIMEOUT 		MS2COUNT(71000)
#endif

#ifndef GSR_ALARM_TIMEOUT
#define GSR_ALARM_TIMEOUT 			MS2COUNT(81000)
#endif

volatile int i;
uint8_t sensors_buffer[20];

