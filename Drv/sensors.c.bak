static TimerHandle sensors_timer = NULL;

bool _sensors_message(Message msg)
{
	if (msg->upar8 == GPIO_GroupFromPin(EXT_INT1))
		if (sensors_timer)
			_sensors_timer(NULL);
}

void Sensors_Init(void)
{
	GPIO_Config(EXT_INT1, GPIO_INPUT, GPIO_PIN_PULLUP_10K);
	GPIO_Config(EXT_CS, GPIO_OUTPUT, GPIO_PIN_OUT_HIGH);
	Message_AddProcessor(_sensors_message, MESSAGES(MESSAGE_GPIO_EVENT));
	GPIO_GroupRegister(EXT_INT1, INTR_RISING_EDGE, 0, NULL);
	Sensors_Wakeup();
}

void Sensors_ResetAlarm(void)
{
	GSR_active = CS_UNKNOWN;
	Message_Add(MESSAGE_CLOCK_SHOW_HAND, IS_OFF, 0, 0);
	GSR_timestamp = 0;
}

void Sensors_Sleep(void)
{
	if (sensors_timer)
	{
		SoftTimers_Delete(sensors_timer);
		sensors_timer = NULL;
	}
}

void Sensors_Wakeup(void)
{
	if (sensors_timer == NULL)
		sensors_timer = SoftTimers_Create(500, true, _sensors_timer);
}
